# Exact versions of the CI tools that are not Go modules of the fixture or
# GitHub Actions. scripts/ci/lib.sh sources this file, and each checks.yml step
# that runs one of these tools sources it too, so this is the only place a
# version is written (scripts/ci/check-pins.sh fails otherwise).
YQ_VERSION=v4.54.1
ZIZMOR_VERSION=1.31.1
ACTIONLINT_VERSION=v1.7.12
SKILLS_REF_VERSION=0.1.1
CHECK_JSONSCHEMA_VERSION=0.38.2
